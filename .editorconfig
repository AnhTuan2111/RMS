# Giữ IntelliJ (backend) và VS Code (frontend) format giống nhau.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,md}]
indent_size = 2

[*.md]
# Hai dấu cách cuối dòng trong Markdown là cú pháp xuống dòng, không được cắt.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
