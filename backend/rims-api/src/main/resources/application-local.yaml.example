# Copy file này thành application-local.yaml (cùng thư mục) rồi điền giá trị thật.
# application-local.yaml đã nằm trong .gitignore nên sẽ không bị commit.
#
# Cách khác: đặt các biến môi trường DB_PASSWORD, MAIL_USERNAME, MAIL_PASSWORD,
# JWT_SIGNER_KEY, VNPAY_HASH_SECRET thay vì dùng file này.

spring:
  datasource:
    password: "mat-khau-sql-server-cua-ban"

  mail:
    username: "email-gui-otp@gmail.com"
    # App password 16 ký tự của Gmail, KHÔNG phải mật khẩu đăng nhập.
    # Tạo tại: https://myaccount.google.com/apppasswords
    password: "xxxx xxxx xxxx xxxx"

jwt:
  # Sinh chuỗi mới: openssl rand -base64 48
  signerKey: "thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu"

vnpay:
  # Lấy trong tài khoản sandbox VNPay của bạn.
  hash-secret: "chuoi-bi-mat-vnpay"
