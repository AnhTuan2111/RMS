{
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "printWidth": 90,
  "tabWidth": 4,
  "useTabs": false,
  "bracketSpacing": false,
  "bracketSameLine": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.css"],
      "options": {
        "printWidth": 120
      }
    },
    {
      "files": ["*.json", "*.md"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
